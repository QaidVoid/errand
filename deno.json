{
  "$schema": "https://raw.githubusercontent.com/denoland/deno/refs/heads/main/cli/schemas/config-file.v1.json",
  "name": "@qaidvoid/errand",
  "version": "0.1.0",
  "exports": "./src/main.ts",
  "license": "MIT OR Apache-2.0",
  "tasks": {
    "ascii": "deno run --allow-read --allow-run scripts/check_ascii.ts",
    "build": "deno task build:web && deno task build:bin",
    "build:bin": "deno compile --allow-net --allow-env --allow-read --allow-write --allow-run --include dist/web --output dist/errand src/main.ts",
    "build:docs": "cd docs && deno run -A --node-modules-dir npm:vitepress build .",
    "build:web": "cd web && deno run -A --node-modules-dir npm:vite build .",
    "check": "deno task lint && deno check src/ scripts/ && deno task test && deno task ascii && deno task docs:check && deno task check:web",
    "check:web": "cd web && deno run -A --node-modules-dir npm:svelte-check --threshold error",
    "dev:docs": "cd docs && deno run -A --node-modules-dir npm:vitepress dev .",
    "dev:web": "cd web && deno run -A --node-modules-dir npm:vite .",
    "docs": "deno run --allow-read --allow-write scripts/generate_docs.ts",
    "docs:check": "deno run --allow-read scripts/generate_docs.ts --check",
    "errand": "deno run --allow-net --allow-env --allow-read --allow-write --allow-run src/main.ts",
    "fmt": "deno run --allow-read --allow-run scripts/check_tree.ts fix",
    "lint": "deno run --allow-read --allow-run scripts/check_tree.ts check",
    "start": "deno run --allow-net --allow-env --allow-read --allow-write --allow-run src/main.ts run",
    "test": "deno test --allow-read --allow-write --allow-env --allow-run --allow-net src/ scripts/",
    "typecheck": "deno check src/ scripts/"
  },
  "exclude": [
    "node_modules",
    "docs/.vitepress/cache"
  ],
  "publish": {
    "include": [
      "src",
      "dist/web",
      "deno.json",
      "deno.lock",
      "README.md",
      "LICENSE-MIT",
      "LICENSE-APACHE",
      "config.example.json",
      "config.schema.json"
    ],
    "exclude": [
      "**/*_test.ts"
    ]
  },
  "fmt": {
    "exclude": [
      ".zcode",
      "dist",
      "web",
      "docs/reference",
      "config.schema.json"
    ],
    "lineWidth": 100,
    "indentWidth": 2,
    "useTabs": false,
    "singleQuote": false,
    "semiColons": true,
    "proseWrap": "preserve"
  },
  "lint": {
    "exclude": [
      "dist",
      "web"
    ],
    "rules": {
      "tags": [
        "recommended"
      ],
      "include": [
        "no-console",
        "eqeqeq",
        "explicit-module-boundary-types"
      ]
    }
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/jsonc": "jsr:@std/jsonc@^1.0.2",
    "@std/path": "jsr:@std/path@^1.1.6",
    "discord.js": "npm:discord.js@^14.27.0"
  }
}
